# Copy to .env.local for local dev, and add the same values in Vercel > Settings > Environment Variables.

# Your deployed URL (used in email links), no trailing slash
APP_URL=https://app.ascdev.tech

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe > Developers > API keys, and the signing secret of the webhook endpoint
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend > API Keys. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=re_...
EMAIL_FROM="Ayush at ASC Development <ayush@ascdev.tech>"

# Where internal alerts go. Also shown to clients as the Google Business Profile manager to add.
ADMIN_EMAIL=you@example.com

# 20-minute onboarding call booking link
BOOKING_URL=https://cal.com/...

# Shown in client emails
CONTACT_PHONE=07784 071383

# Password for /admin (any username)
ADMIN_PASSWORD=

# Any long random string. Vercel sends it to the cron route automatically.
CRON_SECRET=

# Twilio (missed call text back + review requests). Use US1 (default region) keys.
# Account SID and Auth Token: Twilio Console home. API key: Account > API keys & tokens.
TWILIO_ACCOUNT_SID=AC...
TWILIO_API_KEY_SID=SK...
TWILIO_API_KEY_SECRET=
# Only used to verify webhook signatures from Twilio
TWILIO_AUTH_TOKEN=
