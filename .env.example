# Copy to .env.local for local dev, and add the same values in Vercel > Settings > Environment Variables.

# Your deployed URL (used in email links), no trailing slash
APP_URL=https://app.ascdev.tech

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe > Developers > API keys, and the signing secret of the webhook endpoint
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend > API Keys. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=re_...
EMAIL_FROM="Ayush at ASC Development <ayush@ascdev.tech>"

# Where internal alerts go. Also shown to clients as the Google Business Profile manager to add.
ADMIN_EMAIL=you@example.com

# 20-minute onboarding call booking link
BOOKING_URL=https://cal.com/...

# Shown in client emails
CONTACT_PHONE=07784 071383

# Password for /admin (any username)
ADMIN_PASSWORD=

# Any long random string. Vercel sends it to the cron route automatically.
CRON_SECRET=

# Twilio (missed call text back + review requests). Both from Twilio Console home > Account Info.
# The Auth Token sends texts and verifies webhook signatures.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=

# SEO autopilot (admin only). Everything below is optional; the feature is off unless SEO_AUTOPILOT=1.
SEO_AUTOPILOT=
# Writes the fixes (titles, pages, posts, replies). console.anthropic.com
ANTHROPIC_API_KEY=
# Google Cloud API key with Places API (New) and PageSpeed Insights enabled: competitor checks and speed tests.
GOOGLE_API_KEY=
# Optional: check what Google's AI and ChatGPT say. Without them Claude's web search stands in.
GEMINI_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
# Fine-grained GitHub token (Contents + Pull requests, read and write) for client site repos.
GITHUB_TOKEN=
# Read-only Vercel token, to find a site's GitHub repo from its domain. VERCEL_TEAM_ID if the sites are in a team.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# Bing Webmaster Tools API key, and any random 32 letters/numbers for IndexNow.
BING_WEBMASTER_API_KEY=
INDEXNOW_KEY=
# Hard stop on AI spend across all clients, pounds a month (default 30).
SEO_AI_MONTHLY_CAP_GBP=30
# Any long random string. Encrypts WordPress application passwords.
SEO_ENCRYPTION_KEY=
